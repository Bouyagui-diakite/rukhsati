# =============================================================================
# Modèle de configuration PRODUCTION — Rukhsati
# =============================================================================
# Copier vers .env sur le serveur de production, puis :
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan config:cache && php artisan route:cache
#
# ⚠️ Sécurité : NE JAMAIS déployer avec APP_DEBUG=true (fuite de traces).
# ⚠️ Extension PHP requise : ext-gd (dompdf embarque le sceau du PDF d'agrément).
# =============================================================================

APP_NAME=Rukhsati
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.rukhsati.mr

# Domaine du frontend — seule origine autorisée par CORS.
FRONTEND_URL=https://rukhsati.mr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Forcer HTTPS derrière un proxy/loadbalancer.
# ASSET_URL="${APP_URL}"

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Base de données (MySQL/PostgreSQL en production, pas SQLite).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rukhsati
DB_USERNAME=rukhsati
DB_PASSWORD=

# File d'attente pour les traitements asynchrones (PDF, futures notifications).
QUEUE_CONNECTION=database

# Sessions/cache : database ou redis en production.
SESSION_DRIVER=database
CACHE_STORE=database

# Génération du PDF d'agrément.
FILESYSTEM_DISK=local
LICENSE_DISK=local
LICENSE_VERIFY_URL="${FRONTEND_URL}/verifier"

# Courrier (activer quand les notifications e-mail seront branchées).
MAIL_MAILER=log
